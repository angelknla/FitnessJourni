# Copy to .env.local and fill in. Server-only — no NEXT_PUBLIC_ prefix, so the
# key is never sent to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co

# Dashboard -> Settings -> API keys -> "Publishable" (or "Legacy anon").
# Never the secret / service_role key: that bypasses Row Level Security.
SUPABASE_ANON_KEY=

# Optional: set this to put the whole app behind one shared passcode.
# Leave it unset and the app is open (the gate is off).
APP_PASSCODE=

# Optional: which member may remove people entirely (the bin beside the tabs).
# Matched on their name, case-insensitively. Defaults to Angel when unset.
ADMIN_MEMBER=
