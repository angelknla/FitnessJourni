# Copy to .env.local and fill in. Server-only — no NEXT_PUBLIC_ prefix, so the
# key is never sent to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co

# Dashboard -> Settings -> API keys -> "Secret key".
# This bypasses RLS and must remain server-only.
SUPABASE_SECRET_KEY=

# Required for account enrollment and signed login sessions.
APP_PASSCODE=

# Optional: which member may remove people entirely (the bin beside the tabs).
# Matched on their name, case-insensitively. Defaults to Angel when unset.
ADMIN_MEMBER=
